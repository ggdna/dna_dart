{
  // dna_dart is a DNA package: dna/ is authored by hand and is the last
  // layer of its own instantiation.
  "version": 1,

  // The parent DNA: the individual ggdna topic layers. Declared as
  // regular dependencies in pubspec.yaml, so pub installs them
  // transitively for every consumer.
  // Not dna_ggdna and not dna_helix: this layer carries the Dart topic,
  // the authoring topic is not part of it.
  "layers": [
    "dna_readme",
    "dna_guides",
    "dna_translate",
    "dna_index",
    "dna_blog",
    "dna_install",
    "dna_vscode",
    "dna_clean_code",
    "dna_scripts",
    "dna_gg"
  ]
}
