{
  // dna_dart is a DNA package: dna/ is authored by hand and is the last
  // layer of its own instantiation. "role": "dna" is also what makes this
  // package usable as a layer at all — a dna/ folder alone does not.
  "version": 1,
  "role": "dna",

  // The parent DNA. Declared as a regular dependency in pubspec.yaml, so
  // pub installs it transitively for every consumer.
  "layers": ["dna_base"]
}
